# Copy this file to .env and fill in real values before running.

DATABASE_URL=mysql://orbifon_user:change_me@127.0.0.1:3306/orbifon
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_chars
PORT=8080

# Local path where meme/post images are stored (must be outside web-executable dirs)
UPLOAD_DIR=./uploads
MAX_IMAGE_BYTES=5242880
